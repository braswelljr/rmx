.nh
.TH "RMX" "1" "Jan 2024" "rmx" "rmx manual"

.SH NAME
rmx - Remove (unlink) files and directories — a cross-platform drop-in for rm.


.SH SYNOPSIS
\fBrmx [OPTION]... [FILE]... [flags]\fP


.SH DESCRIPTION
rmx removes each FILE. By default it does not remove directories; use -r to
remove a directory and everything under it, or -d to remove an empty directory.


.SH OPTIONS
\fB-d\fP, \fB--dir\fP[=false]
	remove empty directories

.PP
\fB-f\fP, \fB--force\fP[=false]
	ignore nonexistent files and arguments, never prompt

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for rmx

.PP
\fB--interactive\fP[=""]
	prompt according to WHEN: never, once, or always

.PP
\fB--no-preserve-root\fP[=false]
	do not treat '/' specially

.PP
\fB--one-file-system\fP[=false]
	when removing recursively, skip directories on a different file system

.PP
\fB--preserve-root\fP[=true]
	do not remove '/' (default)

.PP
\fB-i\fP, \fB--prompt-each\fP[=false]
	prompt before every removal

.PP
\fB-I\fP, \fB--prompt-once\fP[=false]
	prompt once before removing more than three files, or when removing recursively

.PP
\fB-r\fP, \fB--recursive\fP[=false]
	remove directories and their contents recursively

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	explain what is being done

.PP
\fB--version\fP[=false]
	output version information and exit
